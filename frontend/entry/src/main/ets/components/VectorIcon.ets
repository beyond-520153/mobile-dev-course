/**
 * 渲染一个矢量图标
 *
 * 用法：VectorIcon({ path: Icons.SEARCH, iconSize: 16, color: Theme.TEXT_SUB })
 */
@Component
export struct VectorIcon {

  /** 图标路径，取自 Icons */
  @Prop path: string = '';
  /** 显示边长（vp） */
  @Prop iconSize: number = 22;
  /** 填充色，默认主文字色 */
  @Prop color: string = Theme.TEXT;

  build() {
    Shape() {
      Path()
        .commands(this.path)
        .fill(this.color)
    }
    .width(this.iconSize)
    .height(this.iconSize)
    .viewPort({ x: 0, y: 0, width: 24, height: 24 })
  }
}
